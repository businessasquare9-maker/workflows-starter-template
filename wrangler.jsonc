/** Wrangler configuration for Alex Pizza AI Voice Agent.
 * Replace the D1 database ID placeholder with the existing database ID before deploying.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alex-pizza-voice-agent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alex-pizza-db",
      "database_id": "REPLACE_WITH_YOUR_EXISTING_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "upload_source_maps": true
}
